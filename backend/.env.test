# Test Environment Configuration
NODE_ENV=test

# Test MongoDB Configuration (will be overridden by in-memory database)
MONGODB_URI=mongodb://localhost:27018/task_analytics_test

# Test Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6380

# Test Export Configuration
EXPORT_DIR=./test-exports
EXPORT_FILE_TTL=86400
EXPORT_MAX_FILE_SIZE=10485760
EXPORT_CACHE_TTL=3600

# Test Socket.IO Configuration
SOCKET_IO_CORS_ORIGIN=http://localhost:5173

# Test JWT Configuration
JWT_SECRET=test-jwt-secret-key

# Test CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Test Rate Limiting
EXPORT_RATE_LIMIT=10
EXPORT_RATE_WINDOW=60000

# Test File Cleanup
EXPORT_CLEANUP_INTERVAL=3600000